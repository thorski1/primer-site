---
import Analytics from '../components/Analytics.astro';

interface Props {
  title:       string;
  description: string;
  canonical?:  string;
  ogImage?:    string;
  schema?:     object;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage   = '/og-primer.png',
  schema,
} = Astro.props;

const ogImageAbsolute = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0a1628" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="thorski1" />
  <meta name="keywords" content="educational game for kids, terminal game for children, learning game phonics, math game kids, science game kids, coding game children, kids educational app, learn to read game, Neal Stephenson Diamond Age, interactive learning, free kids game" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="The Young Lady's Illustrated Primer" />
  <meta property="og:url"         content={canonical} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImageAbsolute} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"   content="The Young Lady's Illustrated Primer — educational terminal adventure" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageAbsolute} />

  <!-- JSON-LD Structured Data -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" />

  <!-- Analytics (COPPA-safe: memory persistence, no identity) -->
  <Analytics />

  <style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
      --gold:    #f5c842;
      --gold-dim:#c9a234;
      --bg:      #0a1628;
      --bg-2:    #0f1e35;
      --bg-3:    #152540;
      --border:  #1e3a5f;
      --muted:   #4a6fa0;
      --puck:    #b388ff;
      --text:    #d4e8ff;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Lora', Georgia, serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      min-height: 100vh;
      overflow-x: hidden;
    }

    ::selection { background: var(--gold); color: var(--bg); }

    a { color: var(--gold); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .gold      { color: var(--gold); }
    .gold-glow { color: var(--gold); text-shadow: 0 0 20px rgba(245,200,66,0.5), 0 0 40px rgba(245,200,66,0.2); }
    .puck      { color: var(--puck); }
    .muted     { color: var(--muted); }
    .mono      { font-family: 'JetBrains Mono', monospace; }

    pre, code  { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body>
  <slot />
</body>
</html>
